# Скопируйте в apps/api/.env и заполните секреты (файл .env не коммитится).
DATABASE_URL=postgresql://recipe:recipe@localhost:5432/recipe_manager?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:4200
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
OPENROUTER_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=openrouter
# Только бесплатно: openrouter/free или model-id:free
AI_MODEL=openrouter/free
# AI_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE=http://localhost:3000/uploads
AI_RATE_LIMIT_PER_HOUR=20
